{
  "name": "@eamode/pi-commit",
  "version": "0.1.0",
  "description": "pi extension for automatic changelog-friendly Conventional Commits with submodule support.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EAmode/pi-commit.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "conventional-commits",
    "git",
    "autocommit"
  ],
  "files": [
    "src",
    "README.md",
    "plans"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pack:dry-run": "npm pack --dry-run",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "release:local": "semantic-release --no-ci"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^25.8.0",
    "semantic-release": "^25.0.3",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "pi": {
    "extensions": [
      "src/index.ts"
    ]
  }
}
