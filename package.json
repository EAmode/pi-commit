{
  "name": "@eamode/pi-commit",
  "version": "1.3.1",
  "description": "pi extension for automatic changelog-friendly Conventional Commits with submodule support.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/EAmode/pi-commit.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "conventional-commits",
    "git",
    "autocommit"
  ],
  "files": [
    "extensions",
    "src",
    "assets",
    "README.md",
    "CHANGELOG.md",
    ".pi-commit.example.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pack:dry-run": "npm pack --dry-run",
    "release": "semantic-release  --no-ci",
    "release:dry-run": "semantic-release --dry-run --no-ci"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.4.1",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "pi": {
    "extensions": [
      "extensions/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/EAmode/pi-commit/main/assets/screenshot.png"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
